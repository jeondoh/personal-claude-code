{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/build/**)",
      "Read(./**/dist/**)",
      "Read(./**/out/**)",
      "Read(./**/target/**)",
      "Read(./**/.next/**)",
      "Read(./**/.nuxt/**)",
      "Read(./**/.svelte-kit/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/.vercel/**)",
      "Read(./**/.gradle/**)",
      "Read(./**/.mvn/**)",
      "Read(./**/coverage/**)",
      "Read(./**/.nyc_output/**)",
      "Read(./**/.cache/**)",
      "Read(./**/.parcel-cache/**)",
      "Read(./**/.swc/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/.pytest_cache/**)",
      "Read(./**/.mypy_cache/**)",
      "Read(./**/.ruff_cache/**)",
      "Read(./**/*.tsbuildinfo)",
      "Read(./**/*.min.js)",
      "Read(./**/*.min.css)",
      "Read(./**/*.map)",
      "Read(./**/package-lock.json)",
      "Read(./**/yarn.lock)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/Cargo.lock)",
      "Read(./**/poetry.lock)",
      "Read(./**/uv.lock)",
      "Read(./**/*.log)",
      "Read(./**/logs/**)",
      "Read(./**/.DS_Store)",
      "Read(./**/*.iml)",
      "Read(./**/.idea/**)"
    ]
  }
}
